#!/bin/sh
# Runs scripts/save_offer.py with whichever Python this system has, on Windows python3 is often a dead store alias
root="$(cd "$(dirname "$0")/.." && pwd)"
for python in python3 python py; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
        exec "$python" "$root/scripts/save_offer.py" "$@"
    fi
done
echo "FAILED: Python 3.10 or newer not found. Nothing was written." >&2
exit 3
